---
# yamllint configuration compatible with ansible-lint's production profile
# (https://ansible.readthedocs.io/projects/lint/rules/yaml/).
extends: default

ignore: |
  .venv/
  .ansible/
  .local-test/

rules:
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  truthy:
    allowed-values: ["true", "false"]
    # GitHub Actions uses the bare key `on:`.
    check-keys: false
  # These files predate this configuration and are owned by other changes; add "---" there
  # and drop them from this list.
  document-start:
    ignore: |
      compose.yml
      parameters.yml
  line-length:
    max: 160
    level: warning
    # The membership task's one-line Jinja expression (playbook.yml); wrap it there and drop this.
    ignore: |
      playbook.yml
