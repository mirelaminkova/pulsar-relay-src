- id: [[ names.runner_id ]]
  load: galaxy.jobs.runners.pulsar:PulsarMQJobRunner
  params:
[% if req.backend == "relay" %]
    relay_url: [[ req.relay_url | q ]]
    relay_username: [[ req.relay_username | q ]]
    relay_password: "{{ [[ names.relay_vault_var ]] }}"
    relay_topic_prefix: [[ req.relay_topic_prefix | q ]]
    galaxy_url: [[ site.galaxy_url | q ]]
[% else %]
    amqp_url: "pyamqp://[[ names.mq_user ]]:{{ [[ names.vault_var ]] }}@[[ site.mq_host ]]:[[ site.mq_port ]]/[[ names.vhost ]]?ssl=1"
    galaxy_url: [[ site.galaxy_url | q ]]
    manager: production
    amqp_acknowledge: "true"
    amqp_ack_republish_time: 300
    amqp_consumer_timeout: 2.0
    amqp_publish_retry: "true"
    amqp_publish_retry_max_retries: 60
[% endif %]
