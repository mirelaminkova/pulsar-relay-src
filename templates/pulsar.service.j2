# Generated by Ansible (pulsar-relay-src)
[Unit]
Description=Pulsar (relay mode)
After=network-online.target docker.service{{ ' autofs.service' if _relay_pulsar_cvmfs | bool else '' }}
Wants=network-online.target

[Service]
Type=simple
User={{ relay_pulsar_user }}
Group={{ relay_pulsar_user }}
UMask=022
WorkingDirectory={{ _relay_pulsar_root }}
# server.ini only configures logging; Pulsar reads app.yml from the same directory.
ExecStart={{ relay_pulsar_venv }}/bin/pulsar-main --config_dir {{ relay_pulsar_config_dir }} --ini_path {{ relay_pulsar_config_dir }}/server.ini
Restart=always
RestartSec=10
# Apptainer from the PPA is unprivileged (no setuid starter) and still works
# under no_new_privs: Ubuntu 24.04 allows its AppArmor user-namespace profile.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
