[Unit]
Description=Refresh Pulsar Relay administrators from the SRC CO group
After=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/usr/bin/python3 {{ relay_install_dir }}/scripts/sync_admins.py --group {{ relay_admin_co_group }} --directory {{ relay_install_dir }}/.policy
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths={{ relay_install_dir }}/.policy
ProtectHome=true
PrivateTmp=true
