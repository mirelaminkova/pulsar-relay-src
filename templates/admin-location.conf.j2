# Generated by Ansible. Contains the private SRC-to-relay authentication key.
location /admin/ {
    error_page 401 = @custom_401;
    auth_request /validate;
    auth_request_set $relay_sram_user $upstream_http_username;
    proxy_set_header X-SRC-User $relay_sram_user;
    proxy_set_header X-SRC-Proxy-Secret "{{ _relay_proxy_secret }}";
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_pass http://127.0.0.1:{{ relay_port }}/;
    proxy_http_version 1.1;
    proxy_buffering off;
    proxy_read_timeout 300;
    client_max_body_size 1m;
}
