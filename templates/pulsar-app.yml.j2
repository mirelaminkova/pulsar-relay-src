# Generated by Ansible (pulsar-relay-src). Contains the relay pair password.
# Relay mode: an http(s) message_queue_url switches Pulsar to pulsar-relay.
message_queue_url: {{ ('http://127.0.0.1:' ~ relay_port) | to_json }}
message_queue_username: {{ relay_pair_username | to_json }}
message_queue_password: {{ _relay_pair_password | to_json }}
relay_topic_prefix: {{ relay_topic_prefix | to_json }}

staging_directory: {{ relay_pulsar_staging_dir | to_json }}
persistence_directory: {{ relay_pulsar_persistence_dir | to_json }}
job_metrics_config_file: {{ (relay_pulsar_config_dir ~ '/job_metrics_conf.xml') | to_json }}

managers:
{{ relay_pulsar_managers | to_nice_yaml(indent=2) | indent(2, true) }}
